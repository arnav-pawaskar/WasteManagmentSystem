    {
      "name": "3. Admin",
      "item": [
        {
          "name": "Configure and Restart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"status is configured_and_started\", () => pm.expect(body.status).to.eql(\"configured_and_started\"));",
                  "pm.test(\"config echoed back\", () => pm.expect(body.config.zones).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{admin_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/system/config",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "system",
                "config"
              ]
            },
            "description": "Restarts the shared simulation with a new configuration. Admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zones\": 3,\n  \"bins_per_zone\": 15,\n  \"trucks_per_zone\": 1,\n  \"update_interval\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Trigger Election",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"election initiated\", () => pm.expect(pm.response.json().status).to.eql(\"election_initiated\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{admin_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/election/trigger",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "election",
                "trigger"
