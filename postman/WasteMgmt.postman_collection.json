{
  "info": {
    "_postman_id": "fb5f0dfa-5f97-4ad4-9f8c-328a71879afe",
    "name": "Fog Waste Management API",
    "description": "Tests for the FastAPI service in web/app.py. Select the 'Fog Waste Management' environment, set admin_key, then run the whole collection in order with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responds in < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const body = pm.response.json();",
                  "pm.test(\"status is ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
                  "pm.test(\"running is boolean\", () => pm.expect(body.running).to.be.a(\"boolean\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness check. Public."
          }
        },
        {
          "name": "System Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responds in < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const body = pm.response.json();",
                  "pm.test(\"has configuration, fog_nodes, election_status\", () => {",
                  "    pm.expect(body).to.have.property(\"configuration\");",
                  "    pm.expect(body).to.have.property(\"fog_nodes\");",
                  "    pm.expect(body).to.have.property(\"election_status\");",
                  "});",
                  "pm.test(\"a leader is elected\", () => pm.expect(body.election_status.current_leader).to.not.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/system/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "system",
                "status"
              ]
            },
            "description": "Full system status: config, bin statistics, fog nodes, ledger, election. Public."
          }
        },
        {
          "name": "Bins",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responds in < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const bins = pm.response.json();",
                  "pm.test(\"returns a non-empty array\", () => pm.expect(bins).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"bins have id, zone, position, fill level\", () => {",
                  "    pm.expect(bins[0]).to.include.all.keys(\"bin_id\", \"zone_id\", \"x\", \"y\", \"fill_level\", \"is_overflowing\");",
                  "});",
                  "pm.test(\"fill levels are 0-100\", () => bins.forEach(b => pm.expect(b.fill_level).to.be.within(0, 100)));",
                  "pm.collectionVariables.set(\"first_bin_id\", bins[0].bin_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bins",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "bins"
              ]
            },
            "description": "All bins with position and fill level. Saves the first bin id for 'Empty Bin'. Public."
          }
        },
        {
          "name": "Routes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responds in < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.test(\"returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/routes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "routes"
              ]
            },
            "description": "Active truck routes (may be empty until bins overflow). Public."
          }
        },
        {
          "name": "Network Topology",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responds in < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const body = pm.response.json();",
                  "pm.test(\"has nodes and edges\", () => pm.expect(body).to.have.all.keys(\"nodes\", \"edges\"));",
                  "pm.test(\"exactly one leader\", () => pm.expect(body.nodes.filter(n => n.is_leader).length).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/network",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "network"
              ]
            },
            "description": "Fog nodes, their election state, and peer links. Public."
          }
        },
        {
          "name": "Events",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responds in < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.test(\"at most 20 events\", () => pm.expect(pm.response.json().length).to.be.at.most(20));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/events?limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Recent event log. Public."
          }
        }
      ]
    },
