            },
            "description": "Runs the Invitation election from the given zone (~2 s). Admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initiator_zone\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
