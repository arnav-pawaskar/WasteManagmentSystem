# Copy to .env (local) or /etc/wms.env (server). Never commit the real values.

# Required for Start/Stop/Election/Empty-bin. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_API_KEY=change-me

# Start a default simulation (3 zones, 15 bins, 1 truck) when the server boots
AUTOSTART=true

# Bind address for web/launch.py (the systemd unit sets its own)
HOST=127.0.0.1
PORT=8000

# --- Cloud tier (Supabase + Firebase Hosting), free, no card ----------------
# Supabase dashboard -> Project Settings -> API (Data API URL and API keys)
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key (sb_secret_...) or legacy service_role key.
# Used ONLY by the fog layer on this machine to write snapshots. Never share it.
SUPABASE_SECRET_KEY=

# Publishable key (sb_publishable_...) or legacy anon key.
# Shipped to the public dashboard by hosting/build.py; read-only thanks to RLS.
SUPABASE_PUBLISHABLE_KEY=

# Seconds between snapshots sent to Supabase
CLOUD_PUBLISH_INTERVAL=3
